PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# MongoDB
# Docker local (dev): mongodb://mongo:27017/loadlink
# Atlas (prod): mongodb+srv://<user>:<pass>@cluster.mongodb.net/loadlink
MONGODB_URI=mongodb://mongo:27017/loadlink

# Firebase admin
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Firebase client frontend (VITE_ prefix for all frontend vars)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Geoapify -> used server side for route computation on load creation
GEOAPIFY_KEY=

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ca-central-1  # Or whatever region you want
AWS_S3_BUCKET=loadlink-docs
